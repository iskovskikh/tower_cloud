# Managed by Ansible (role adminvps_traefik) — do not edit by hand.
# Static Traefik configuration.

entryPoints:
  web:
    address: ":80"
    # HTTP-01 challenges are answered on :80 before the redirect is applied.
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
  # GitLab SSH (gitlab-shell via NodePort 30222 on the k8s nodes).
  gitlab-ssh:
    address: ":30222"

providers:
  # Directory provider: routers.yml + backend.yml are separate files, so the
  # failover timer can rewrite the backend without touching the routers.
  file:
    directory: /etc/traefik/conf.d
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ adminvps_traefik_acme_email }}
      storage: /etc/traefik/acme/acme.json
      httpChallenge:
        entryPoint: web

log:
  level: INFO

accessLog: {}
