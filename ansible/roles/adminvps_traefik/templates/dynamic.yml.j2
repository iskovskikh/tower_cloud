# Managed by Ansible (role adminvps_traefik) — do not edit by hand.
# Dynamic Traefik configuration (file provider; watched for changes).
http:
  routers:
{% for host in adminvps_traefik_hosts %}
    {{ host | replace('.', '-') }}:
      rule: "Host(`{{ host }}`)"
      entryPoints:
        - websecure
      service: ingress
      tls:
        certResolver: letsencrypt
{% endfor %}

  services:
    # All public hosts share the home ingress-nginx entry points; the Host
    # header (passHostHeader defaults to true) selects the k8s Ingress.
    ingress:
      loadBalancer:
        serversTransport: k8s-insecure
        servers:
{% for server in adminvps_traefik_ingress_servers %}
          - url: "{{ server }}"
{% endfor %}

  serversTransports:
    k8s-insecure:
      # ingress-nginx serves the internal `tower-ca` certificate; the tunnel is
      # already encrypted, so the back-end certificate is not verified.
      insecureSkipVerify: true

# GitLab SSH: a single non-TLS TCP entry point (:2222) forwarded to the
# gitlab-shell NodePort through the SSH reverse tunnel.
tcp:
  routers:
    gitlab-ssh:
      entryPoints:
        - gitlab-ssh
      rule: "HostSNI(`*`)"
      service: gitlab-ssh
    # VLESS Reality shares public :443 with the HTTPS front end. The client uses
    # the camouflage SNI; Traefik passes that TLS stream through untouched to
    # the Xray inbound (which does its own Reality handshake). All other SNI
    # values fall through to the HTTP routers above and are terminated here.
    xray-reality:
      entryPoints:
        - websecure
      rule: "HostSNI(`{{ adminvps_traefik_xray_reality_sni }}`)"
      service: xray-reality
      tls:
        passthrough: true
  services:
    gitlab-ssh:
      loadBalancer:
        servers:
{% for server in adminvps_traefik_gitlab_ssh_servers %}
          - address: "{{ server }}"
{% endfor %}
    xray-reality:
      loadBalancer:
        servers:
          - address: "{{ adminvps_traefik_xray_reality_backend }}"
