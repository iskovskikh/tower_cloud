# Managed by Ansible (role adminvps_traefik) — do not edit by hand.
# Dynamic Traefik configuration (file provider directory; watched for changes).
# Routers + the static relay/Xray services live here; the ingress/gitlab-ssh
# backends are in backend.yml, which the failover timer rewrites.

http:
  routers:
{% for host in adminvps_traefik_hosts %}
    {{ host | replace('.', '-') }}:
      rule: "Host(`{{ host }}`)"
      entryPoints:
        - websecure
      service: ingress
      tls:
        certResolver: letsencrypt
{% endfor %}
    # wstunnel fallback transport. Traefik terminates TLS for the relay host and
    # forwards plain WebSocket to the local wstunnel server (role
    # wstunnel_fallback), which authenticates the client by upgrade-path prefix.
    relay:
      rule: "Host(`{{ adminvps_traefik_relay_host }}`)"
      entryPoints:
        - websecure
      service: relay
      tls:
        certResolver: letsencrypt

  services:
    relay:
      loadBalancer:
        servers:
          - url: "{{ adminvps_traefik_relay_backend }}"

  serversTransports:
    k8s-insecure:
      # ingress-nginx serves the internal `tower-ca` certificate; the tunnel is
      # already encrypted, so the back-end certificate is not verified.
      insecureSkipVerify: true

# GitLab SSH: a single non-TLS TCP entry point (:30222) forwarded to the
# gitlab-shell NodePort through the SSH reverse tunnel (backend in backend.yml).
tcp:
  routers:
    gitlab-ssh:
      entryPoints:
        - gitlab-ssh
      rule: "HostSNI(`*`)"
      service: gitlab-ssh
    # VLESS Reality shares public :443 with the HTTPS front end. The client uses
    # the camouflage SNI; Traefik passes that TLS stream through untouched to
    # the Xray inbound (which does its own Reality handshake). All other SNI
    # values fall through to the HTTP routers above and are terminated here.
    xray-reality:
      entryPoints:
        - websecure
      rule: "HostSNI(`{{ adminvps_traefik_xray_reality_sni }}`)"
      service: xray-reality
      tls:
        passthrough: true
  services:
    xray-reality:
      loadBalancer:
        servers:
          - address: "{{ adminvps_traefik_xray_reality_backend }}"
